pipeline {
    agent any

    environment {
        REMOTE_HOST      = '13.41.167.97'
        REMOTE_USER      = 'consultant'
        REMOTE_PASSWORD  = 'Cl0ud3ra@2026#Secur3!'
        PROJECT_DIR      = '/home/consultant/yamini/tfl_Project1'
        KAFKA_BROKER     = 'ip-172-31-6-42.eu-west-2.compute.internal:9092'
        KAFKA_TOPIC      = 'tfl_arrivals'
        HBASE_TABLE      = 'yamini_tfl_arrivals'
        HDFS_SPARK_BASE  = '/tmp/yamini/tfl_spark_streaming'
        HIVESERVER2_HOST = '18.175.245.20'
        GITHUB_RAW_KAFKA = 'https://raw.githubusercontent.com/nandamuriyamini/TFL_Project/main/src/kafka'
        GITHUB_RAW_SPARK = 'https://raw.githubusercontent.com/nandamuriyamini/TFL_Project/main/src/spark'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Stage 1: Git Checkout'
                echo '========================================='
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Create Directories') {
            steps {
                echo '========================================='
                echo 'Stage 2: Create Directories on Cloudera'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "mkdir -p ${PROJECT_DIR}/kafka ${PROJECT_DIR}/spark" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Directories created"
                '''
            }
        }

        stage('Download Scripts from GitHub') {
            steps {
                echo '========================================='
                echo 'Stage 3: Pull Latest Scripts from GitHub'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "cd ${PROJECT_DIR}/kafka && \
                         wget -q -O send_data_to_kafka.py   ${GITHUB_RAW_KAFKA}/send_data_to_kafka.py && \
                         wget -q -O write_kafka_to_hbase.py ${GITHUB_RAW_KAFKA}/write_kafka_to_hbase.py && \
                         cd ${PROJECT_DIR}/spark && \
                         wget -q -O spark_streaming_tfl.py  ${GITHUB_RAW_SPARK}/spark_streaming_tfl.py && \
                         wget -q -O hive_spark_table.sql    ${GITHUB_RAW_SPARK}/hive_spark_table.sql && \
                         echo 'All scripts downloaded successfully'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Stop Existing Processes') {
            steps {
                echo '========================================='
                echo 'Stage 4: Kill Any Previously Running Scripts'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "pkill -9 -f send_data_to_kafka.py  2>/dev/null || true; \
                         pkill -9 -f write_kafka_to_hbase.py 2>/dev/null || true; \
                         pkill -9 -f spark_streaming_tfl.py  2>/dev/null || true; \
                         pkill -9 -f TFL_Spark_Streaming      2>/dev/null || true; \
                         yarn application -list 2>/dev/null | grep TFL_Spark_Streaming | grep -oE 'application_[0-9]+_[0-9]+' | xargs -r yarn application -kill 2>/dev/null || true; \
                         sleep 5; \
                         echo 'Old processes stopped'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Prepare HDFS for Spark') {
            steps {
                echo '========================================='
                echo 'Stage 5: Clean and Prepare Spark HDFS Directories'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "HADOOP_USER_NAME=hdfs hdfs dfs -rm -r -f -skipTrash ${HDFS_SPARK_BASE} 2>/dev/null || true; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -mkdir -p ${HDFS_SPARK_BASE}/output; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -mkdir -p ${HDFS_SPARK_BASE}/checkpoint; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -chmod -R 777 ${HDFS_SPARK_BASE}; \
                         echo 'HDFS Spark directories ready'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Start Kafka Producer') {
            steps {
                echo '========================================='
                echo 'Stage 6: Start TFL API → Kafka Producer'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup python3 ${PROJECT_DIR}/kafka/send_data_to_kafka.py > /tmp/producer_success.log 2>&1 & \
                         echo \"Producer PID: \$!\"" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Producer started"
                '''
            }
        }

        stage('Start HBase Consumer') {
            steps {
                echo '========================================='
                echo 'Stage 7: Start Kafka → HBase Consumer'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup python3 ${PROJECT_DIR}/kafka/write_kafka_to_hbase.py > /tmp/hbase_consumer.log 2>&1 & \
                         echo \"Consumer PID: \$!\"" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Consumer started"
                '''
            }
        }

        stage('Start Spark Streaming') {
            steps {
                echo '========================================='
                echo 'Stage 8: Start Kafka → HDFS Spark Streaming Job'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh \
                        -o StrictHostKeyChecking=no \
                        -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "nohup spark-submit --master local[2] --name TFL_Spark_Streaming --driver-memory 512m --conf spark.sql.parquet.writeLegacyFormat=true ${PROJECT_DIR}/spark/spark_streaming_tfl.py > /tmp/spark_streaming.log 2>&1 & echo \"Spark PID: \$!\"" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Spark Streaming started"
                '''
            }
        }

        stage('Verify Kafka Topic') {
            steps {
                echo '========================================='
                echo 'Stage 9: Verify Kafka Topic and Messages'
                echo '========================================='
                sh '''
                    sleep 30
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "echo '--- Kafka Topics ---'; \
                         kafka-topics --bootstrap-server ${KAFKA_BROKER} --list 2>/dev/null; \
                         echo '--- Topic Details ---'; \
                         kafka-topics --bootstrap-server ${KAFKA_BROKER} --describe --topic ${KAFKA_TOPIC} 2>/dev/null; \
                         echo '--- Message Count ---'; \
                         kafka-run-class kafka.tools.GetOffsetShell --broker-list ${KAFKA_BROKER} --topic ${KAFKA_TOPIC} --time -1 2>/dev/null" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Verify HBase Table') {
            steps {
                echo '========================================='
                echo 'Stage 10: Verify HBase Records'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        'echo "--- HBase Record Count ---" && echo "count '"'"'yamini_tfl_arrivals'"'"'" | hbase shell -n 2>/dev/null | grep -E "^[0-9]|row"; echo "--- Sample Records ---" && echo "scan '"'"'yamini_tfl_arrivals'"'"', {LIMIT => 3}" | hbase shell -n 2>/dev/null | head -20' 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Verify Spark Output and Create Hive Table') {
            steps {
                echo '========================================='
                echo 'Stage 11: Check Spark HDFS Output + Register Hive Table'
                echo '========================================='
                sh '''
                    sleep 300
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "echo '--- Spark HDFS Output ---'; \
                         hdfs dfs -ls ${HDFS_SPARK_BASE}/output 2>/dev/null || echo 'No Parquet files yet - Spark still initialising'; \
                         echo '--- Output Size ---'; \
                         hdfs dfs -du -s -h ${HDFS_SPARK_BASE}/output 2>/dev/null || echo '0 bytes'; \
                         echo '--- Creating Hive External Table ---'; \
                         beeline -u 'jdbc:hive2://${HIVESERVER2_HOST}:10000/default' -n consultant -p 'Cl0ud3ra@2026#Secur3!' -f ${PROJECT_DIR}/spark/hive_spark_table.sql" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Check All Logs') {
            steps {
                echo '========================================='
                echo 'Stage 12: Check Producer, Consumer and Spark Logs'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "echo '--- Running Processes (PID CPU START CMD) ---'; \
                         ps aux | grep -E 'send_data_to_kafka|write_kafka_to_hbase|spark_streaming_tfl' | grep -v grep; \
                         echo '--- Producer Log (last 10 lines) ---'; \
                         tail -10 /tmp/producer_success.log 2>/dev/null || echo 'No producer log yet'; \
                         echo '--- Consumer Log (last 10 lines) ---'; \
                         tail -10 /tmp/hbase_consumer.log 2>/dev/null || echo 'No consumer log yet'; \
                         echo '--- Spark Log Size ---'; \
                         wc -l /tmp/spark_streaming.log 2>/dev/null || echo 'No spark log'; \
                         echo '--- Spark Errors and Exceptions ---'; \
                         grep -E 'AnalysisException|Failed to find|Exception in thread|Caused by:|ERROR.*kafka|data source' /tmp/spark_streaming.log 2>/dev/null | head -20 || echo 'No errors found'; \
                         echo '--- Spark Log (last 20 lines) ---'; \
                         tail -20 /tmp/spark_streaming.log 2>/dev/null || echo 'No spark log yet'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }
    }

    post {
        success {
            echo '========================================='
            echo 'TFL STREAMING PIPELINE RUNNING SUCCESSFULLY'
            echo '========================================='
            echo "Server        : ${REMOTE_HOST}"
            echo "Kafka Topic   : ${KAFKA_TOPIC}"
            echo "HBase Table   : ${HBASE_TABLE}"
            echo "Spark Output  : ${HDFS_SPARK_BASE}/output"
            echo "Hive Table    : yamini_tfl_proj.tfl_spark_arrivals"
            echo "Producer log  : /tmp/producer_success.log"
            echo "Consumer log  : /tmp/hbase_consumer.log"
            echo "Spark log     : /tmp/spark_streaming.log"
            echo '========================================='
        }
        failure {
            echo '========================================='
            echo 'TFL STREAMING PIPELINE FAILED - check logs above'
            echo '========================================='
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
