pipeline {
    agent any

    environment {
        REMOTE_HOST      = '13.41.167.97'
        REMOTE_USER      = 'consultant'
        REMOTE_PASSWORD  = 'Cl0ud3ra@2026#Secur3!'
        PROJECT_DIR      = '/home/consultant/yamini/tfl_Project1'
        HDFS_SPARK_BASE  = '/tmp/yamini/tfl_spark_streaming'
        HIVESERVER2_HOST = '18.175.245.20'
        KAFKA_TOPIC      = 'tfl_arrivals'
        GITHUB_RAW       = 'https://raw.githubusercontent.com/nandamuriyamini/TFL_Project/main/src/spark'
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========================================='
                echo 'Stage 1: Git Checkout'
                echo '========================================='
                checkout scm
                sh 'git log -1 --oneline'
            }
        }

        stage('Create Spark Directory') {
            steps {
                echo '========================================='
                echo 'Stage 2: Create Spark Directory on Cloudera'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "mkdir -p ${PROJECT_DIR}/spark" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Spark directory created"
                '''
            }
        }

        stage('Download Scripts') {
            steps {
                echo '========================================='
                echo 'Stage 3: Download Spark Script and Hive DDL from GitHub'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "cd ${PROJECT_DIR}/spark && \
                         wget -q -O spark_streaming_tfl.py ${GITHUB_RAW}/spark_streaming_tfl.py && \
                         wget -q -O hive_spark_table.sql  ${GITHUB_RAW}/hive_spark_table.sql && \
                         echo 'Scripts downloaded successfully'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Prepare HDFS') {
            steps {
                echo '========================================='
                echo 'Stage 4: Clean and Prepare HDFS Directories'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "HADOOP_USER_NAME=hdfs hdfs dfs -rm -r -f -skipTrash ${HDFS_SPARK_BASE} 2>/dev/null || true; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -mkdir -p ${HDFS_SPARK_BASE}/output; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -mkdir -p ${HDFS_SPARK_BASE}/checkpoint; \
                         HADOOP_USER_NAME=hdfs hdfs dfs -chmod -R 777 ${HDFS_SPARK_BASE}; \
                         echo 'HDFS directories ready'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Run Spark Streaming Job') {
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                echo '========================================='
                echo 'Stage 5: Submit Spark Structured Streaming Job'
                echo '(Reads Kafka tfl_arrivals for 5 min, writes HDFS Parquet)'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh \
                        -o StrictHostKeyChecking=no \
                        -o UserKnownHostsFile=/dev/null \
                        -o ServerAliveInterval=60 \
                        -o ServerAliveCountMax=10 \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "spark-submit --master yarn --deploy-mode client --name TFL_Spark_Streaming --num-executors 2 --executor-memory 1g --driver-memory 512m --conf spark.sql.parquet.writeLegacyFormat=true --conf spark.yarn.queue=default --packages org.apache.spark:spark-sql-kafka-0-10_2.11:2.4.8 ${PROJECT_DIR}/spark/spark_streaming_tfl.py" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Spark job completed"
                '''
            }
        }

        stage('Verify HDFS Output') {
            steps {
                echo '========================================='
                echo 'Stage 6: Check Parquet Files in HDFS'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "echo '--- Output directory ---'; \
                         hdfs dfs -ls ${HDFS_SPARK_BASE}/output 2>/dev/null || echo 'No output files yet'; \
                         echo '--- Total size ---'; \
                         hdfs dfs -du -s -h ${HDFS_SPARK_BASE}/output 2>/dev/null || echo '0 bytes'" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                '''
            }
        }

        stage('Create Hive External Table') {
            steps {
                echo '========================================='
                echo 'Stage 7: Register Parquet as Hive External Table'
                echo '========================================='
                sh '''
                    sshpass -p "${REMOTE_PASSWORD}" ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
                        ${REMOTE_USER}@${REMOTE_HOST} \
                        "beeline -u 'jdbc:hive2://${HIVESERVER2_HOST}:10000/default' \
                            -n consultant -p 'Cl0ud3ra@2026#Secur3!' \
                            -f ${PROJECT_DIR}/spark/hive_spark_table.sql" 2>&1 | \
                        grep -v "ITC Big Data Lab" | grep -v "Commands:" | grep -v "HDFS home:" | grep -v "━" || true
                    echo "Hive table created"
                '''
            }
        }
    }

    post {
        success {
            echo '========================================='
            echo 'TFL SPARK STREAMING PIPELINE COMPLETED SUCCESSFULLY'
            echo '========================================='
            echo "Kafka Topic  : ${KAFKA_TOPIC}"
            echo "HDFS Output  : ${HDFS_SPARK_BASE}/output"
            echo "Hive Table   : yamini_tfl_proj.tfl_spark_arrivals"
            echo '========================================='
        }
        failure {
            echo '========================================='
            echo 'TFL SPARK STREAMING PIPELINE FAILED - check logs above'
            echo '========================================='
        }
        always {
            echo 'Pipeline execution completed'
        }
    }
}
